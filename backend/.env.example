# Copy to backend/.env (never commit .env). Every setting has a safe dev default.
CC_ENV=dev
CC_BUILD=local
# CC_PERSISTENCE=memory                      # no database at all
# CC_DATABASE_URL=sqlite+aiosqlite:///./cc_platform.db
# CC_DATABASE_URL=postgresql+asyncpg://cc:cc@localhost:5432/cc   # needs asyncpg
CC_SEED_DEMO_DATA=true
CC_SESSION_SECRET=change-me-to-a-long-random-string-of-32-bytes-or-more
CC_SESSION_TTL_MINUTES=480
CC_LOCKOUT_MAX_ATTEMPTS=5
CC_LOCKOUT_MINUTES=15
CC_MFA_TTL_SECONDS=300
CC_MFA_MAX_ATTEMPTS=3
CC_DEV_MFA_CODE=000000                       # seeded accounts without an authenticator only
# Part 4 (slice 11): invitation and reset links, TOTP, the dev mailbox
CC_PUBLIC_APP_URL=http://localhost:5173      # the SPA origin the emails link to
# CC_INVITATION_TTL_HOURS=48
# CC_PASSWORD_RESET_TTL_MINUTES=60
# CC_DEV_MAILBOX=true                        # default: on only with CC_ENV=dev; never in prod
# CC_TOTP_ISSUER=LATAM Bank CC
# CC_TOTP_SECRET_KEY=<Fernet key>            # default (dev/test): derived from CC_SESSION_SECRET
CC_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CC_HOST=127.0.0.1
CC_PORT=8000
# CC_REALTIME_EXPIRY_CHECK_SECONDS=30      # idle sockets re-check session expiry
# CC_NOTIFICATION_SWEEP_SECONDS=30         # slice 10: "Caso por vencer" sweep; 0 = off
# ADR 0003 (slices 13-14): the assistant. All of it is off unless URL and keys are both set.
# CC_AGENT_CORE_URL=http://127.0.0.1:8001    # agentcore serve (the platform itself uses 8000)
# CC_AGENT_KEYS_FILE=.agent-keys/private.json  # python -m cc_platform.scripts.gen_agent_keys
# CC_AGENT_CORE_TIMEOUT_SECONDS=60
# Deploy brief P4: resilience of every call to agent-core (defaults shown).
# CC_CORE_TIMEOUT_ASSISTANT_SECONDS=        # unset = CC_AGENT_CORE_TIMEOUT_SECONDS (also COPILOT, SUGGESTIONS, BUILDER)
# CC_CORE_TIMEOUT_REGISTRY_SECONDS=30
# CC_CORE_TIMEOUT_EVALUATE_SECONDS=120
# CC_CORE_CONNECT_TIMEOUT_SECONDS=3
# CC_CORE_PROBE_TIMEOUT_SECONDS=2
# CC_CORE_RETRY_ATTEMPTS=2                  # only calls safe to repeat; a timeout is never retried
# CC_CORE_RETRY_BASE_DELAY_SECONDS=0.2
# CC_CORE_RETRY_MAX_DELAY_SECONDS=2
# CC_CORE_BREAKER_FAILURE_THRESHOLD=5
# CC_CORE_BREAKER_RESET_SECONDS=30
# CC_ASSISTANT_AGENT=recepcion@prod
# CC_ASSISTANT_LANGUAGES=["es","pt"]
# CC_ASSISTANT_SWEEP_SECONDS=30             # recovers assistant work lost with its process; 0 = off
# CC_INTERNAL_SERVICE_TOKEN=<random secret>  # /api/v1/internal/* (agent-core's grant_active); unset = off
# CC_COPILOT_AGENT=copiloto-asesor@prod     # slice 15: the analyst's copilot
# CC_BUILDER_AGENT=constructor-chat@prod    # slice 16: the builder agent supervisors chat with
# CC_ASSISTANT_STEP_UP_CODE=000000           # simulated second factor (development stand-in)
# CC_BANK_CUSTOMER_LINKS_FILE=.agent-keys/bank-links.json   # {"CUS-...": "<dataset customer_id>"}
CC_LOG_LEVEL=INFO
CC_LOG_FORMAT=json
