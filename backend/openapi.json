{
  "components": {
    "schemas": {
      "HealthResponse": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "enum": [
                "ok",
                "failing"
              ],
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "Language": {
        "enum": [
          "es",
          "pt"
        ],
        "title": "Language",
        "type": "string"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "examples": [
              "daniela.rios@latambank.example"
            ],
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "examples": [
              "demo1234"
            ],
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LoginResponse": {
        "properties": {
          "challengeId": {
            "title": "Challengeid",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "methods": {
            "items": {
              "$ref": "#/components/schemas/MfaMethod"
            },
            "title": "Methods",
            "type": "array"
          },
          "mfaRequired": {
            "title": "Mfarequired",
            "type": "boolean"
          }
        },
        "required": [
          "mfaRequired",
          "challengeId",
          "expiresAt",
          "methods"
        ],
        "title": "LoginResponse",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionOut"
          },
          "staff": {
            "$ref": "#/components/schemas/StaffOut"
          }
        },
        "required": [
          "staff",
          "session"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MetaResponse": {
        "properties": {
          "apiVersion": {
            "title": "Apiversion",
            "type": "string"
          },
          "build": {
            "title": "Build",
            "type": "string"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "name",
          "version",
          "build",
          "environment",
          "apiVersion"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "MfaMethod": {
        "enum": [
          "totp",
          "sms",
          "backup_code"
        ],
        "title": "MfaMethod",
        "type": "string"
      },
      "MfaRequest": {
        "additionalProperties": false,
        "properties": {
          "challengeId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Challengeid",
            "type": "string"
          },
          "code": {
            "examples": [
              "000000"
            ],
            "maxLength": 32,
            "minLength": 4,
            "title": "Code",
            "type": "string"
          },
          "method": {
            "$ref": "#/components/schemas/MfaMethod",
            "default": "totp"
          }
        },
        "required": [
          "challengeId",
          "code"
        ],
        "title": "MfaRequest",
        "type": "object"
      },
      "ProblemCode": {
        "enum": [
          "invalid_credentials",
          "mfa_invalid",
          "mfa_challenge_invalid",
          "account_locked",
          "unauthenticated",
          "session_expired",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "conflict",
          "concurrent_update",
          "invalid_transition",
          "invalid_value",
          "policy_violation",
          "validation_error",
          "domain_error",
          "application_error",
          "invalid_topic",
          "invalid_message",
          "http_error",
          "internal_error"
        ],
        "title": "ProblemCode",
        "type": "string"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "description": "RFC 7807 problem. ``code`` is the stable machine identifier clients branch on.\n\nThe optional members below are the documented extensions; a domain error may add other\nstructured details (e.g. ``currentStatus``), hence ``additionalProperties``.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationIssue"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "validation_error: one entry per invalid field.",
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "remainingAttempts": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "invalid_credentials, mfa_invalid: failed attempts left before the lock.",
            "title": "Remainingattempts"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Requestid"
          },
          "requiredRoles": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/StaffRole"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "forbidden: roles that may perform the action.",
            "title": "Requiredroles"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "examples": [
              "urn:cc-platform:problem:account_locked"
            ],
            "title": "Type",
            "type": "string"
          },
          "unlockAt": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "account_locked: when the lock ends.",
            "title": "Unlockat"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "SessionOut": {
        "properties": {
          "expiresAt": {
            "format": "date-time",
            "title": "Expiresat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "expiresAt"
        ],
        "title": "SessionOut",
        "type": "object"
      },
      "SessionResponse": {
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionOut"
          },
          "staff": {
            "$ref": "#/components/schemas/StaffOut"
          },
          "token": {
            "title": "Token",
            "type": "string"
          },
          "tokenType": {
            "const": "Bearer",
            "default": "Bearer",
            "title": "Tokentype",
            "type": "string"
          }
        },
        "required": [
          "token",
          "session",
          "staff"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "StaffLevel": {
        "description": "Analyst seniority; drives abono limits (policies R7/R8).",
        "enum": [
          "Junior",
          "Mid-Senior",
          "Senior",
          "Specialist"
        ],
        "title": "StaffLevel",
        "type": "string"
      },
      "StaffListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/StaffOut"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "StaffListResponse",
        "type": "object"
      },
      "StaffOut": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "languages": {
            "items": {
              "$ref": "#/components/schemas/Language"
            },
            "title": "Languages",
            "type": "array"
          },
          "level": {
            "$ref": "#/components/schemas/StaffLevel"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "requiresFourEyes": {
            "title": "Requiresfoureyes",
            "type": "boolean"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/StaffRole"
            },
            "title": "Roles",
            "type": "array"
          },
          "team": {
            "title": "Team",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "roles",
          "level",
          "languages",
          "team",
          "requiresFourEyes"
        ],
        "title": "StaffOut",
        "type": "object"
      },
      "StaffRole": {
        "description": "Platform roles. They combine: one person may hold several (brief §1).",
        "enum": [
          "analyst",
          "supervisor",
          "automation",
          "admin"
        ],
        "title": "StaffRole",
        "type": "string"
      },
      "ValidationIssue": {
        "properties": {
          "loc": {
            "items": {
              "type": "string"
            },
            "title": "Loc",
            "type": "array"
          },
          "msg": {
            "title": "Msg",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationIssue",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionToken": {
        "description": "Session token returned by POST /api/v1/auth/mfa.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API of the LATAM Bank contact-center platform (transaction-dispute intake). Errors are RFC 7807 `application/problem+json` with a stable `code`. Realtime: WebSocket `/api/v1/ws?token=…` with `{type,id,occurredAt,data}` envelopes.",
    "title": "CC Platform API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Wrong credentials return `invalid_credentials` with `remainingAttempts`; the fifth consecutive failure returns `account_locked` (423) with `unlockAt`.",
        "operationId": "auth_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          },
          "423": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          }
        },
        "summary": "Check email and password; always asks for a second factor",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          }
        },
        "security": [
          {
            "SessionToken": []
          }
        ],
        "summary": "End the current session (also closes its realtime sockets)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "operationId": "auth_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          }
        },
        "security": [
          {
            "SessionToken": []
          }
        ],
        "summary": "The signed-in staff member and session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/mfa": {
      "post": {
        "description": "Development code: `000000`. Use the returned token as `Authorization: Bearer`. A wrong code returns `mfa_invalid` with `remainingAttempts`; wrong codes also count toward the account lockout, so the failure that reaches it returns `account_locked` (423) with `unlockAt`, as does any attempt while the account is locked.",
        "operationId": "auth_verify_mfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          },
          "423": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          }
        },
        "summary": "Verify the second factor and start a session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "operationId": "system_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "A dependency is failing"
          }
        },
        "summary": "Liveness and dependency checks",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "operationId": "system_meta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "API version and build",
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/staff": {
      "get": {
        "operationId": "people_list_staff",
        "parameters": [
          {
            "description": "Only staff holding this role",
            "in": "query",
            "name": "role",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/StaffRole"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only staff holding this role",
              "title": "Role"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StaffListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807)"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 7807): validation_error"
          }
        },
        "security": [
          {
            "SessionToken": []
          }
        ],
        "summary": "List active staff, optionally by role",
        "tags": [
          "people"
        ]
      }
    }
  }
}
